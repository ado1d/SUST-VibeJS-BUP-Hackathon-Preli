# ---- Required for the LLM interpretation path (mandatory per Problem Statement) ----
OPENAI_API_KEY=sk-your-key-here

# ---- Optional tuning (defaults shown) ----
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional proxy/gateway
OPENAI_TIMEOUT_S=10
OPENAI_FALLBACK_TIMEOUT_S=8
LLM_VALIDATION_RETRIES=1

REQUEST_BUDGET_S=26
CACHE_ENABLED=1
CACHE_MAX_ENTRIES=512
LOG_LEVEL=INFO
NUMERIC_TOLERANCE=0.01
PORT=8000
